/*
 * Corne Keyboard Keymap
 *
 * Based on the ZMK configuration for the Corne keyboard.
 * Original keymap source: https://github.com/SquaredPotato/zmk-config/blob/master/config/kyria.keymap
 *
 * Copyright (c) 2020 The ZMK Contributors
 *
 * SPDX-License-Identifier: MIT

 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

// #include <../boards/shields/corne/boards/nice_nano.overlay> //led interno

/ {
    // Use tapdance to handle the double tap of the shift key
        behaviors {

        //? TAP DANCE ('' and "")
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp SQT>, <&kp DQT>;
        };

        //? TAP DANCE (, and <)
        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp COMMA>, <&kp LT>;
        };

        //? TAP DANCE (. and >)
        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp DOT>, <&kp GT>;
        };

        //? TAP DANCE (- and _)
        td4: tap_dance_4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp MINUS>, <&kp UNDER>;
        };

        //? TAP DANCE (; and :)
        td5: tap_dance_5 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp SEMI>, <&kp COLON>;
        };

        //? TAP DANCE (\ and |)
        td6: tap_dance_6 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp BSLH>, <&kp PIPE>;
        };

        //? TAP DANCE (` and ~)
        td7: tap_dance_7 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp GRAVE>, <&kp TILDE>;
        };

        //? TAP DANCE (= and +)
        td8: tap_dance_8 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp EQUAL>, <&kp PLUS>;
        };

        //? TAP DANCE (/ and ?)
        td9: tap_dance_9 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp SLASH>, <&kp QMARK>;
        };

        //? TAP DANCE ([ and {)
        td10: tap_dance_10 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp LPAR>, <&kp RPAR>;
        };

        //? TAP DANCE (] and })
        td11: tap_dance_11 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        //? TAP DANCE ({ and })
        td12: tap_dance_12 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;
        };

        //? TAP DANCE (Shift and Caps Lock)
        td13: tap_dance_13 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp LSHFT>, <&kp CLCK>;
        };

        // ? Comportamientos de combinación de teclas personalizados
      td_ctrl_cmd_q: tap_dance_ctrl_cmd_q {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp LCTRL>, <&kp LGUI>, <&kp Q>;
        };

        td_cmd_shift_4: tap_dance_cmd_shift_4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp LGUI>, <&kp LSHFT>, <&kp N4>;
        };

        td_ctrl_left: tap_dance_ctrl_left {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp LCTRL>, <&kp LEFT>;
        };

        //? TAP DANCE (RGB ON / RGB OFF)
        td_rgb_onoff: tap_dance_rgb_onoff {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&rgb_ug RGB_ON>, <&rgb_ug RGB_OFF>;
        };

        //? TAP DANCE (T normal / doble-tap = Expandir nivel actual VSCode)
        td_t_expand_current: tap_dance_t_expand_current {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp T>, <&vscode_expand_current>;
        };

        //? TAP DANCE (W normal / doble-tap = Plegar nivel actual VSCode)
        td_w_fold_current: tap_dance_w_fold_current {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp W>, <&vscode_fold_current>;
        };

        //? TAP DANCE (H normal / doble-tap = Expandir todo VSCode)
        td_h_expand_all: tap_dance_h_expand_all {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp H>, <&vscode_expand_all>;
        };

        //? TAP DANCE (M normal / doble-tap = Plegar todo VSCode)
        td_m_fold_all: tap_dance_m_fold_all {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <185>;
            bindings = <&kp M>, <&vscode_fold_all>;
        };


    };

    macros {
        //? Plegar/expandir en VSCode (Cmd+K seguido de una segunda tecla)
        vscode_fold_current: vscode_fold_current {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LG(K)>, <&kp LG(LBKT)>;
        };

        vscode_expand_current: vscode_expand_current {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LG(K)>, <&kp LG(RBKT)>;
        };

        vscode_fold_all: vscode_fold_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LG(K)>, <&kp LG(N0)>;
        };

        vscode_expand_all: vscode_expand_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LG(K)>, <&kp LG(J)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ADD OT
        * Default Layer: Alphanumeric and Symbols
        *
        * ,-----------------------------------------------------.							   ,-----------------------------------------------------.
        * |  RAIS  |   ' "  |   , <  |   . >  |   P    |   Y    |							   |   F    |   G    |   C    |   R    |   L    |  BKSP   |
        * |--------+--------+--------+--------+--------+--------|							   |--------+--------+--------+--------+--------+---------|
        * |  LShift|   A    |   O    |   E    |   U    |   I    |							   |   D    |H/2xExpAll|T/2xExpCur| N    |   S    |   /     |
        * |--------+--------+--------+--------+--------+--------|							   |--------+--------+--------+--------+--------+---------|
        * |  SP_MY |   ;    |   Q    |   J    |   K    |   X    |							   |   B    |M/2xFoldAll|W/2xFoldCur| V   |   Z    |  Enter  |
        * '--------+--------+--------+--------+--------+--------|							   |--------+--------+--------+--------+--------+---------'
        *                            |   GUI  |  LWR   |  SPC   |                              |   ENT  |   RSE  |   ALT  |
        *                            '--------+--------+--------'							   '--------+--------+--------'
        *
        * H/T/M/W: tap normal, doble-tap = shortcuts de VSCode (fold/unfold):
        *   H doble-tap = Expandir todo (Cmd+K, Cmd+J)
        *   M doble-tap = Plegar todo (Cmd+K, Cmd+0)
        *   T doble-tap = Expandir nivel actual (Cmd+K, Cmd+])
        *   W doble-tap = Plegar nivel actual (Cmd+K, Cmd+[)
        */

        default_layer {
            bindings = <
                &kp ESC       &td0         &td1       &td2     &kp P   &kp Y           &kp F &kp G  &kp C     &kp R   &kp L     &kp BSPC
                &kp TAB       &kp A        &kp O      &kp E    &kp U   &kp I           &kp D &td_h_expand_all  &td_t_expand_current     &kp N   &kp S     &td9
                &td13         &td5         &kp Q      &kp J    &kp K   &kp X           &kp B &td_m_fold_all  &td_w_fold_current     &kp V   &kp Z     &kp RET
                                                &kp LGUI    &mo 1   &kp LCTRL          &kp SPACE      &mo 2   &kp RALT
            >;
        };

        /* ADD OT
        * Lower Layer: Function keys and Navigation
        *
        * ,-----------------------------------------------------.							   ,-----------------------------------------------------.
        * |  TAB   |   1    |   2    |   3    |   4    |   5    |							   |   6    |   7    |   8    |   9    |   0    |  BKSP   |
        * |--------+--------+--------+--------+--------+--------|							   |--------+--------+--------+--------+--------+---------|
        * |  F1    |   F2   |   F3   |   F4   |   F5   |   F6   |							   |        |   UP   |        |        |        |   \     |
        * |--------+--------+--------+--------+--------+--------|							   |--------+--------+--------+--------+--------+---------|
        * |   F7   |   F8   |   F9   |   F10  |   F11  |   F12  |							   |  LEFT  |  DOWN  |  RIGHT |   .    |        |         |
        * '----------------------------------------------+------|							   |-----------------------------------------------------'
        *                             |   GUI  |  LWR   |  SPC  |							   |   ENT  |   RSE  |   ALT  |
        *                            '--------+--------+--------'							   '--------+--------+--------'
        */
        lower_layer {
            bindings = <
                &kp TAB    &kp N1      &kp N2     &kp N3      &kp N4      &kp N5                 &kp N6        &kp N7       &kp N8       &kp N9        &kp N0 &kp BSPC
                &kp F1     &kp F2      &kp F3     &kp F4      &kp F5      &kp F6                 &trans        &kp UP       &trans       &trans        &trans  &kp QMARK
                &kp F7     &kp F8      &kp F9     &kp F10     &kp F11     &kp F12                &kp LEFT      &kp DOWN     &kp RIGHT    &kp DOT       &trans  &trans
                                                    &kp LGUI     &trans      &kp SPACE         &kp RET       &mo 3       &kp RALT
            >;
        };

        /* ADD OT
        * Raise Layer: Function keys, Special Characters, and Media Controls
        *
        * ,-----------------------------------------------------.							   ,-------------------------------------------------------.
        * |   TAB   |   !    |   @    |   #    |   $    |   %    |							   |   ^    |   &    |   *    |   (    |   )    |  BSPC   |
        * |---------+--------+--------+--------+--------+--------|							   |--------+--------+--------+--------+--------+---------|
        * |  LCTRL  |   `    |   ~    |        |        |        |							   |   -    |   =    |   [    |   ]    |   \    |   `     |
        * |---------+--------+--------+--------+--------+--------|							   |--------+--------+--------+--------+--------+---------|
        * |  LSHFT  |        |        |        |        |        |							   |   _    |   +    |   {    |   }    |   |    |   ~     |
        * '------------------------------------------------------'							   '-------------------------------------------------------'
        *                           |   LGUI   |  SPC   |  RET   |                             |   RALT   |   FUN   |   RSE   |
        *                           '----------+--------+--------'                             '----------+--------+--------'
        */
        raise_layer {
            bindings = <
                &kp TAB     &kp EXCL  &kp AT     &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC
                &kp LCTRL   &td7      &kp TILDE  &trans    &trans    &trans     &td4       &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &td9
                &kp LSHFT   &trans    &trans     &trans    &trans    &trans     &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                                      &kp LGUI  &trans    &kp SPACE            &kp RET   &trans    &kp RALT
            >;
        };

 /* ADD OT
 * Adjust Layer: Function keys, RGB Control, and Media Controls
 *
 * ,-----------------------------------------------------.							   ,-----------------------------------------------------.
 * |   ESC   |   '    |   ,    |   .    |  VOL+  |   Y    |							   | ON/OFF | SOLID  |BREATHE |RAINBOW | SWIRL  |         |
 * |---------+--------+--------+--------+--------+--------|							   |--------+--------+--------+--------+--------+---------|
 * |   BT0   |  BT1   |  BT2   | PREV   |  PLAY  |  NEXT  |							   | BRT+   | SAT+   | SPD+   | HUE+   |        |         |
 * |---------+--------+--------+--------+--------+--------|							   |--------+--------+--------+--------+--------+---------|
 * |  SHFT   | BTCLR  | BTDISC | REWIND |  VOL-  |  FFWD  |							   | BRT-   | SAT-   | SPD-   | HUE-   |        |         |
 * '-----------------------------------------------------'							   '-----------------------------------------------------'
 *                              |   LGUI   |  SPC   |  RET   |                              |   RALT   |   FUN   |   RSE   |
 *                              '----------+--------+--------'                              '----------+--------+--------'
 *
 * RGB (mitad derecha de adjust_layer):
 *   Fila 1: F: tap=ON, doble-tap=OFF   C=Solid   R=Breathe   L=Rainbow(Spectrum)   siguiente=Swirl
 *   Fila 2 (subir): D=Brillo+  H=Sat+  T=Velocidad+  N=Hue+
 *   Fila 3 (bajar):  B=Brillo-  M=Sat-  W=Velocidad-  V=Hue-
 * Bluetooth (mitad izquierda de adjust_layer):
 *   BT0/BT1/BT2 = seleccionar perfil   BTCLR = borrar emparejamiento actual
 *   BTDISC = forzar desconexion/reconexion
 */
        adjust_layer {
                bindings = <
                &td_ctrl_cmd_q   &kp SQT       &kp COMMA      &td_cmd_shift_4  &kp C_VOLUME_UP    &kp Y                      &td_rgb_onoff    &rgb_ug RGB_EFS_CMD 0  &rgb_ug RGB_EFS_CMD 1  &rgb_ug RGB_EFS_CMD 2  &rgb_ug RGB_EFS_CMD 3  &trans
                &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2   &kp C_PREV       &kp C_PLAY_PAUSE   &kp K_NEXT                 &rgb_ug RGB_BRI  &rgb_ug RGB_SAI        &rgb_ug RGB_SPI        &rgb_ug RGB_HUI        &trans                 &trans
                &mt LSHFT LCAPS  &bt BT_CLR    &bt BT_DISC 0  &kp C_REWIND     &kp C_VOLUME_DOWN  &kp C_FAST_FORWARD         &rgb_ug RGB_BRD  &rgb_ug RGB_SAD        &rgb_ug RGB_SPD        &rgb_ug RGB_HUD        &trans                 &trans
                                                               &kp LGUI         &trans             &kp SPACE                 &kp RET                &trans                 &kp RALT
            >;
        };
 /* ADD OT
 * Control Layer: Function keys, RGB Control, and Media Controls
 *
 * ,-----------------------------------------------------.							   ,-------------------------------------------------------.
 * |   ESC   |   '    |   ,    |   .    |  VOL+  |   Y    |							   |   7    |   8    |   9    |   +     |         |   UP   |
 * |---------+--------+--------+--------+--------+--------|							   |--------+--------+--------+---------+--------+--------+
 * |   TAB   |   A    |   A    | PREV   |  PLAY  |  NEXT  |							   |   4    |   5    |   6    |   -     |    LEFT | RIGHT  |
 * |---------+--------+--------+--------+--------+--------|							   |--------+--------+--------+---------+--------+--------+
 * |   SHFT  |  RGB   |   S    | REWIND |  VOL-  |  FFWD  |							   |   1    |   2    |   3    |   =     |    B    |  DOWN  |
 * '-----------------------------------------------------'							   '-------------------------------------------------------.
 *                          |   LGUI   |  SPC   |  RET   |                              |   RALT   |   FUN   |   RSE   |
 *                          '----------+--------+--------'                              '----------+--------+--------'
 */
        control_layer {
                bindings = <
                &trans          &trans          &trans          &trans          &trans          &trans              &kp N7          &kp N6          &kp N9          &trans          &kp UP          &trans
                &trans          &trans          &trans          &trans          &trans          &trans              &kp N4          &kp N5          &kp N6          &kp LEFT        &kp DOWN        &kp RIGHT
                &trans          &trans          &trans          &trans          &trans          &trans              &kp N1          &kp N2          &kp N3          &trans          &trans          &trans
                                                                &trans          &trans          &trans              &kp N0          &trans          &trans
            >;
        };
    };
};
